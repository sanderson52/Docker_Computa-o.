# Garante LF em arquivos executados/lidos dentro de containers Linux.
# Sem isso, um clone no Windows com core.autocrlf=true gera CRLF e quebra
# scripts sh ($'\r': command not found), SQL de init e arquivos .env.
* text=auto
*.sh          text eol=lf
*.sql         text eol=lf
*.conf        text eol=lf
*.json        text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.ts          text eol=lf
*.txt         text eol=lf
*.md          text eol=lf
*.html        text eol=lf
*.css         text eol=lf
Dockerfile*   text eol=lf
.env*         text eol=lf
.dockerignore text eol=lf
*.docx        binary
